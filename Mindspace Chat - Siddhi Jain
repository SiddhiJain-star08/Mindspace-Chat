<html lang="en">



<head>



  <meta charset="UTF-8">



  <meta name="viewport" content="width=device-width, initial-scale=1.0">



  <title>MindSpace Chat</title>



  <style>



    *{



      margin:0;



      padding:0;



      box-sizing:border-box;



      font-family:Arial, sans-serif;



    }



    html{



      scroll-behavior:smooth;



    }



    body{



      background:linear-gradient(135deg,#4c1d95,#312e81,#be185d);



      color:white;



    }



    .hero{



      height:100vh;



      display:flex;



      flex-direction:column;



      justify-content:center;



      align-items:center;



      text-align:center;



      padding:20px;



    }



    .hero h1{



      font-size:70px;



      margin-bottom:20px;



    }



    .hero p{



      font-size:24px;



      color:#e5e7eb;



      margin-bottom:35px;



      max-width:800px;



      line-height:40px;



    }



    .btn{



      background:#ec4899;



      color:white;



      padding:15px 35px;



      border:none;



      border-radius:50px;



      text-decoration:none;



      font-size:18px;



      transition:0.3s;



      box-shadow:0 0 20px rgba(236,72,153,0.5);



    }



    .btn:hover{



      background:#db2777;



      transform:scale(1.05);



    }



    section{



      padding:90px 20px;



    }



    .container{



      max-width:1100px;



      margin:auto;



    }



    .card{



      background:rgba(255,255,255,0.1);



      padding:40px;



      border-radius:30px;



      backdrop-filter:blur(10px);



      box-shadow:0 0 25px rgba(0,0,0,0.2);



    }



    h2{



      font-size:45px;



      margin-bottom:25px;



      color:#f9a8d4;



      text-align:center;



    }



    .story-text{



      font-size:21px;



      line-height:38px;



      color:#e5e7eb;



      text-align:center;



    }



    .cards{



      display:grid;



      grid-template-columns:repeat(auto-fit,minmax(280px,1fr));



      gap:25px;



      margin-top:50px;



    }



    .work-card{



      background:rgba(255,255,255,0.1);



      padding:35px;



      border-radius:30px;



      text-align:center;



      transition:0.4s;



      backdrop-filter:blur(10px);



      box-shadow:0 0 20px rgba(0,0,0,0.2);



    }



    .work-card:hover{



      transform:translateY(-10px) scale(1.02);



    }



    .icon{



      font-size:55px;



      margin-bottom:15px;



    }



    .work-card h3{



      margin:15px 0;



      font-size:30px;



    }



    .work-card p{



      font-size:18px;



      line-height:32px;



      color:#e5e7eb;



    }



    .contact{



      text-align:center;



    }



    .contact p{



      font-size:20px;



      color:#e5e7eb;



      margin-top:10px;



      line-height:35px;



    }



    .email-btn{



      display:inline-block;



      margin-top:30px;



      background:#3b82f6;



      color:white;



      padding:16px 38px;

